# Layout rules from the style guide. Run on save.
BasedOnStyle: LLVM
Standard: Latest
IndentWidth: 2
ColumnLimit: 100
UseTab: Never
AccessModifierOffset: -2
BreakBeforeBraces: Attach
NamespaceIndentation: None
FixNamespaceComments: true
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
AllowShortFunctionsOnASingleLine: Inline
InsertNewlineAtEOF: true

# "* and & next to the name": const Snapshot &other
PointerAlignment: Right
ReferenceAlignment: Pointer

# These two edit tokens, not just whitespace. Check the diff the first time they run.
# "const goes on the left": Snapshot const & -> const Snapshot &
QualifierAlignment: Left
# "Always use braces after if, for and while"
InsertBraces: true
